# ── Application ──────────────────────────────────
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://yourdomain.ru

# ── Database ─────────────────────────────────────
POSTGRES_PASSWORD=change_this_strong_password_here
DATABASE_URL=postgresql://dental_user:${POSTGRES_PASSWORD}@postgres:5432/dental_db

# ── JWT (RS256) ───────────────────────────────────
# Generate: openssl genrsa -out jwt-private.pem 4096
# Then:     openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ── SMS.ru ────────────────────────────────────────
SMS_RU_API_ID=your-api-id-from-sms.ru

# ── Web Push (VAPID) ──────────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.ru
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Telegram ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── File Uploads ──────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=20

# ── Next.js ───────────────────────────────────────
NEXT_PUBLIC_API_URL=https://yourdomain.ru/api
NEXT_PUBLIC_APP_NAME=Dr. Osmanov
NEXT_PUBLIC_APP_URL=https://yourdomain.ru
